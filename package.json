{
  "name": "docket",
  "version": "1.0.0",
  "description": "Docket – Production-Grade Executive Markdown to PDF Engine",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "cli": "bun run src/cli.ts",
    "tui": "bun run src/tui/app.ts",
    "start": "bun run src/tui/app.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "bun build --compile src/cli.ts --outfile docket"
  },
  "dependencies": {
    "@opentui/core": "^0.5.3",
    "markdown-it": "^15.0.0",
    "puppeteer": "^25.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
