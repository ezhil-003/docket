{
  "name": "docket",
  "version": "1.4.2",
  "description": "Docket – Production-Grade Executive Markdown to PDF Engine",
  "module": "src/cli.ts",
  "bin": {
    "docket": "src/cli.ts"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "cli": "bun run src/cli.ts",
    "tui": "bun run src/tui/app.ts",
    "start": "bun run src/tui/app.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run",
    "build": "bun build --compile src/cli.ts --outfile docket"
  },
  "dependencies": {
    "@opentui/core": "^0.5.3",
    "markdown-it": "^15.0.0",
    "puppeteer": "^25.7.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.1.2",
    "markdownlint": "^0.41.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
